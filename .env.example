# Режим по умолчанию: "live" (API региона 39), "check" (локальный JSON) или "schedule"
RUN_MODE=check

# Источник данных для рабочего режима (Калининградская область — регион 39)
API_BASE_URL=http://opendata.trudvsem.ru/api/v1/vacancies/region/39
MAX_VACANCIES=40
MAX_PAGES=3
# Размер страницы для пагинации через offset/limit (API отдаёт максимум 100)
API_PAGE_SIZE=20

# Путь к локальному JSON для проверочного режима (без обращения к API)
LOCAL_JSON_PATH=data/kantkod_sample_vacancies.json

# Куда сохранять итоговый JSON-отчёт
REPORT_OUTPUT_PATH=output/report.json

# Расписание для фонового цикла
SCHEDULE_INTERVAL_MINUTES=60

# Настройки ИИ (совместимый с OpenAI API эндпоинт: облако или локальная Ollama/LM Studio)
# Вариант без платного аккаунта: ollama pull qwen2.5:7b && ollama serve
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=60

# Сколько символов текста вакансии передавать в модель (защита от раздувания промпта)
MAX_TEXT_CHARS=1500

# Лог-файл прогонов (папка logs/ в .gitignore)
LOG_FILE=logs/run.log

# Доп. сценарий: вакансии с минимальным числом замечаний
GOOD_VACANCIES_OUTPUT_PATH=output/good_vacancies.json
GOOD_MAX_ISSUES=1

# Рыночный ориентир для оценки оплаты (Калининградская область, 2026)
# Средняя начисленная зарплата, Калининградстат, январь–август 2026
MARKET_AVG_SALARY=83200
# Медиана предлагаемых зарплат, ГородРабот.ру, октябрь 2026
MARKET_MEDIAN_SALARY=70000
MARKET_REGION=Калининградская область
